{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS2 preview calibration manifest",
  "type": "object",
  "required": ["version", "authority", "captureStatus", "naming", "sources", "scenarios", "resolutions"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "authority": { "type": "string" },
    "captureStatus": { "enum": ["awaiting-real-game-captures", "ready-for-review", "calibrated"] },
    "naming": { "const": "{scenario}-{resolution}-{source}.png" },
    "sources": { "type": "array", "items": { "enum": ["browser", "cs2"] }, "minItems": 2, "maxItems": 2 },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "preset": { "type": "string" },
          "shareCode": { "type": "string" },
          "checks": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "resolutions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "width", "height", "displayMode"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "displayMode": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
